# Umami on Fly.io — secret values reference (do NOT commit a filled-in copy).
# These are pushed with `fly secrets set` (see README), not loaded as a file.
#
# Generate the two cryptographic values:
#   APP_SECRET:                 openssl rand -hex 32
#   TWO_FACTOR_ENCRYPTION_KEY:  openssl rand -hex 32

# --- db app (set on umami-db-af) ---
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=changeme_db_password

# --- app (set on umami-af) ---
# Must embed the same password as the db app's POSTGRES_PASSWORD:
DATABASE_URL=postgresql://umami:changeme_db_password@umami-db-af.internal:5432/umami
APP_SECRET=changeme_64_hex
# Optional — only needed if you enable 2FA on the admin account:
TWO_FACTOR_ENCRYPTION_KEY=changeme_64_hex
